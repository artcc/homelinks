{
  "name": "homelinks",
  "version": "0.0.20",
  "description": "Keep all your Docker apps in one place",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "lint": "eslint .",
    "test": "node --test tests/*.test.js",
    "test:ui": "PLAYWRIGHT_BROWSERS_PATH=./node_modules/.cache/ms-playwright UI_TEST=1 node --test tests/*.test.js",
    "test:ui:install": "TMPDIR=./node_modules PLAYWRIGHT_BROWSERS_PATH=./node_modules/.cache/ms-playwright playwright install chromium --only-shell"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "lucide": "0.577.0",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "picomatch": "^4.0.7",
    "sharp": "^0.35.4",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "eslint": "^8.57.0"
  },
  "overrides": {
    "tar": "^7.5.7"
  }
}
